def get_os_knowledge():
    """Return the complete OS knowledge base."""
    return OS_KNOWLEDGE
def search_os_knowledge(query):
    """Search OS knowledge using keyword matching and simple scoring."""
    if not query:
        return []
    text = str(query).strip().lower()
    if not text:
        return []
    results = []
    for item in OS_KNOWLEDGE:
        score = 0
        topic = item.get("topic", "").lower()
        name = item.get("name", "").lower()
        if topic and topic in text:
            score += 10
        if name and name in text:
            score += 10
        for keyword in item.get("keywords", []):
            keyword_lower = keyword.lower()
            if keyword_lower in text:
                score += max(2, len(keyword_lower))
        if score > 0:
            result = dict(item)
            result["score"] = score
            results.append(result)
    results.sort(key=lambda x: x.get("score", 0), reverse=True)
    return results
